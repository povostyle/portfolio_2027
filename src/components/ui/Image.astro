---
/**
 * Imagen optimizada sobre astro:assets (idea tomada del boilerplate de Locomotive).
 * CSS: styles/components/image.css
 *
 * - Genera srcset en varios anchos y formato moderno. Con imágenes de src/assets (import) Astro
 *   conoce el tamaño; con URLs remotas se infiere (inferSize).
 * - width + height → la imagen recorta a esa proporción (object-fit: cover).
 * - loading="lazy" (por defecto) → aparece con fundido al cargar (.is-loaded).
 * - tag="figure" + caption → <figure> con <figcaption>.
 * - Admite data-scroll-* para parallax: <Image … data-scroll data-scroll-speed="-0.1" />
 *
 *   import foto from "@assets/images/foto.jpg";
 *   <Image src={foto} alt="…" sizes="(min-width: 64em) 50vw, 100vw" />
 */
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  tag?: "div" | "figure";
  caption?: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  [attr: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  tag = "div",
  caption,
  class: className,
  sizes = "(min-width: 64em) 50vw, 100vw",
  widths = [480, 800, 1200, 1600, 2400],
  loading = "lazy",
  ...rest
} = Astro.props;

const Tag = tag;
const Caption = tag === "figure" ? "figcaption" : "div";
const cover = Boolean(width && height);
const remote = typeof src === "string";

// <Image> de Astro exige width y height o inferSize según el tipo de src; se monta aquí y se pasa entero.
const imageProps = {
  class: "image__img",
  src,
  alt,
  ...(cover ? { width, height } : remote ? { inferSize: true } : {}),
  widths,
  sizes,
  loading,
  decoding: "async",
  fetchpriority: loading === "eager" ? "high" : undefined,
  onload: loading === "lazy" ? "this.closest('.image')?.classList.add('is-loaded')" : undefined,
};
---
<Tag
  class:list={["image", { "image--cover": cover, "image--lazy": loading === "lazy" }, className]}
  style={cover ? `--ar: ${width} / ${height}` : undefined}
  {...rest}
>
  <AstroImage {...(imageProps as any)} />
  {caption && <Caption class="image__caption">{caption}</Caption>}
</Tag>
